# Large data/cache files (exceed GitHub's 100MB limit)
A2_FashionDataset/processed/*.npy

# Raw dataset images (large binary assets)
A2_FashionDataset/FashionDataset/
A2_FashionDataset/__MACOSX/

# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/

# Jupyter checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
.train_cache/
artifacts/task1/_superseded_*/

# Claude Code: personal overrides and runtime state (shared settings.json is not ignored)
.claude/settings.local.json
.claude/*.lock

# Derived posterior caches. Regenerated in ~2 minutes by
# src/evaluation/prior_shift.graded_probabilities(); 3.8 MB each and keyed to a
# checkpoint, so committing them would rot the moment a candidate is promoted.
artifacts/task1/graded_probabilities_*.npz

# Candidate checkpoints from the recipe search. Each is ~1.7 MB and fully
# reproducible from its recipe name and the fixed seed, e.g.
#   python -m src.training.train_item_type --recipe tail_sqrt --epochs 40 #       --select-on macro_f1 --tag dep
# Only the adopted model (artifacts/task1/task1_cnn.pt) is committed; the
# comparison itself lives in outputs/evaluation/task1_recipe_comparison.csv.
artifacts/task1/candidate_*.pt

# Generated labelling aid: 3.6 MB of base64 thumbnails, rebuilt on demand by
# scripts/build_label_sheet.py. The labels it produces are committed; it is not.
outputs/input_images_labelling.html

# Task 4 resolution caches: 2.2 GB at 120x160, rebuilt by
# scripts/build_task4_cache.py from data that is already tracked.
A2_FashionDataset/processed/task4_cache_*.npy
A2_FashionDataset/processed/task4_masks_*.npy

# 120x160 candidate experiments write here. Generated: normalisation stats from
# candidate_120x160 --smoke, encoders and run summaries from the training arms.
# main does not track them either; promoting a candidate copies it to artifacts/task4/.
artifacts/task*_120x160/
